{
  "name": "@thednp/color",
  "author": "thednp",
  "version": "1.0.15",
  "description": "🎨 Fast color conversion tool made in TypeScript",
  "keywords": [
    "color",
    "manipulate",
    "typescript"
  ],
  "homepage": "http://github.com/thednp/color",
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thednp/color.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "scripts": {
    "pre-test": "pnpm clean-coverage",
    "test": "pnpm pre-test && vitest",
    "test-ui": "pnpm pre-test && vitest --ui",
    "dev": "pnpx vite serve experiments --port 3000",
    "prepublishOnly": "pnpm up --latest && pnpm format && pnpm lint && pnpm build",
    "clean-coverage": "rm -rf coverage .nyc_output",
    "format": "deno fmt src",
    "lint": "pnpm lint:types && pnpm lint:ts",
    "lint:ts": "deno lint src",
    "lint:types": "tsc --noEmit",
    "fix:ts": "deno lint src --fix",
    "build": "pnpm vite build"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@8.6.12"
}
